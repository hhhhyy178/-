{
  "name": "bonjourlab",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build && node scripts/prepare-standalone.mjs",
    "start": "node scripts/start-server.mjs",
    "db:setup": "node --env-file-if-exists=.env scripts/init-db.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "package:windows": "node scripts/package-windows.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
